# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ir para o Git (ele já está no .gitignore).

# Ambiente: development | production | test
NODE_ENV=development

# Porta do servidor HTTP
PORT=3333

# Conexão MySQL no formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:sua_senha_aqui@localhost:3306/gestao_clientes"

# Segredo usado para assinar os tokens JWT (mínimo 32 caracteres).
# Gere um aleatório com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres"

# Tempo de validade do token (ex.: 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# Origem autorizada pelo CORS (onde o front-end roda). Como o front é servido
# pelo próprio Express, normalmente é o mesmo endereço do servidor.
CORS_ORIGIN=http://localhost:3333

# Fuso horário usado para decidir "que dia é hoje" (vencimentos, atrasos).
APP_TIMEZONE=America/Sao_Paulo

# Credenciais do admin criado pelo seed (apenas desenvolvimento!)
SEED_ADMIN_EMAIL=admin@gestao.dev
SEED_ADMIN_PASSWORD=admin123
